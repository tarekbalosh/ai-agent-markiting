# ===================================================
# CoreLogic Systems - AI Marketing Agent
# ===================================================

# قاعدة البيانات (SQLite للتطوير، PostgreSQL للإنتاج)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/corelogic_agent"

# Gemini AI API Key
# احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (بديل)
# OPENAI_API_KEY="your-openai-api-key-here"

# Resend API للبريد الإلكتروني
# احصل عليه من: https://resend.com
RESEND_API_KEY="your-resend-api-key-here"
FROM_EMAIL="agent@corelogic-systems.com"

# LinkedIn API
LINKEDIN_ACCESS_TOKEN="your-linkedin-access-token-here"
LINKEDIN_PERSON_URN="urn:li:person:YOUR_PERSON_ID"
LINKEDIN_ORGANIZATION_URN="urn:li:organization:YOUR_ORG_ID"

# إعدادات الخادم
PORT=3001
NODE_ENV="development"

# CORS Origins (للـ Dashboard)
ALLOWED_ORIGINS="http://localhost:3000,https://your-dashboard.vercel.app"
